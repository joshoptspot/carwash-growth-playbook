---
interface Props {
  variant?: 'home' | 'episode';
}
const { variant = 'home' } = Astro.props;
---

<nav class="fixed top-0 w-full z-50 bg-white border-b border-gray-200 shadow-sm">
  <div class="max-w-6xl mx-auto px-6 py-3 flex items-center justify-between gap-4">
    <a href="/" class="font-display text-lg md:text-xl tracking-wider text-[#19c4d8] leading-none shrink-0">
      CAR WASH GROWTH PLAYBOOK
    </a>

    <div class="flex items-center gap-2 md:gap-3 shrink-0">
      <a
        href="https://optspot.com"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden md:inline-flex text-xs font-bold text-[#0a2430] bg-[#e9e71e] px-3 py-1.5 rounded-full hover:opacity-90 transition"
      >
        OptSpot.com
      </a>

      {variant === 'home' ? (
        <>
          <a
            href="https://open.spotify.com/show/4ZtAHnCtlILanAMSypKxuZ"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:inline-flex text-xs font-semibold px-3 py-1.5 rounded-full bg-[#1DB954] text-black hover:opacity-90 transition"
          >
            Spotify
          </a>
          <a
            href="https://www.youtube.com/playlist?list=PLmW8Eb6a0_CsXiUiBiaP17g20rxl3yHLi"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:inline-flex text-xs font-semibold px-3 py-1.5 rounded-full bg-red-600 text-white hover:opacity-90 transition"
          >
            YouTube
          </a>
        </>
      ) : (
        <a href="/" class="text-sm text-gray-500 hover:text-[#0a2430] transition">
          &larr; All Episodes
        </a>
      )}
    </div>
  </div>
</nav>
